config ESP32S31_RADIO_XIP
	bool
	depends on ESP32S31_RADIO_SMODE
	select CRC32
	default y
	help
	  Fixed executable flash mapping and 40 KiB writable SRAM arena.
	  The radio image and Linux module must be built together.

config ESP32S31_RADIO_SMODE_DRIVER
	tristate "ESP32-S31 S-mode radio runtime"
	depends on ESP32S31_RADIO_XIP
	depends on WLAN && m
	select CFG80211
	select MAC80211
	help
	  Build the reloadable esp32s31-radio.ko. It owns the shared PHY, SRAM,
	  clocks and interrupts and exposes cfg80211 from one module. The
	  prelinked ESP-IDF closure (radio.bin) runs from its fixed flash-XIP
	  slot. Built without Bluetooth: only mode=wifi works.

config ESP32S31_WIFI_SOFTMAC
	bool
	depends on ESP32S31_RADIO_SMODE_DRIVER && MAC80211
	default y
	help
	  Single-STA mac80211 bridge with native MAC CCMP, bounded TX
	  aggregation and software replay/reorder checks on received frames.

config ESP32S31_RADIO_BLOBS
	bool
	depends on ESP32S31_RADIO_SMODE_DRIVER
	default y

source "drivers/platform/mips/Kconfig"

